# ==============================================================================
# INVOICE PRO AGIOS — ISOLATED R&D PROTOTYPE ENVIRONMENT CONFIGURATION
# Classification: Experimental Prototype (DO NOT USE PRODUCTION CREDENTIALS)
# ==============================================================================

# 1. APPLICATION & DOMAIN CONFIGURATION (Environment-Driven, Never Hardcoded)
NEXT_PUBLIC_APP_NAME="Invoice Pro Agios"
NEXT_PUBLIC_APP_ENV="prototype_preview"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PREFERRED_DOMAIN="invoicepro.agiosventure.com"

# 2. DATABASE & MULTI-TENANT STORAGE (Isolated Dev/Test Instance Only)
NEXT_PUBLIC_SUPABASE_URL="https://your-isolated-dev-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-isolated-dev-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-isolated-dev-service-role-key-server-only"

# 3. AI PROVIDER CONFIGURATION (Server-Side Only — Never Expose to Browser)
AI_PROVIDER="google_gemini"
GEMINI_API_KEY="your-gemini-api-key-server-only"
GEMINI_MODEL="gemini-3.8-flash"
AI_EXTRACTION_MODE="simulated_or_live_key" # Falls back to deterministic parser if key is omitted in local preview

# 4. STRIPE PAYMENTS & CONNECT V2 ARCHITECTURE (Simulated or Stripe Test Mode Only)
# Modes: "simulated" (default for Session 1 local preview) | "stripe_test"
PAYMENT_EXECUTION_MODE="simulated"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_isolated_placeholder"
STRIPE_SECRET_KEY="sk_test_isolated_placeholder_server_only"
STRIPE_WEBHOOK_SECRET="whsec_test_isolated_placeholder_server_only"
STRIPE_CONNECT_API_VERSION="2026-02-25.acacia" # Supports Stripe Accounts v2 (/v2/core/accounts)
STRIPE_SAAS_SUBSCRIPTION_PRICE_ID="price_test_agios_saas_plan_placeholder"

# 5. OUTBOUND EMAIL / REMINDER ENGINE (Sandbox / Console Capture Only in Session 1)
EMAIL_DELIVERY_MODE="sandbox_log_only" # Prevents accidental real customer emails
RESEND_API_KEY="re_test_isolated_placeholder_server_only"
EMAIL_FROM_ADDRESS="noreply@preview.invoicepro.agiosventure.com"
